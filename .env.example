# Copy to .env (local) and set the same names in the Vercel project's
# Environment Variables. Never commit real values. Never prefix with VITE_.

# --- SEO (build time) ---
# Optional: public origin used for canonical, og:url, sitemap and robots.txt.
# Defaults to Vercel's production domain, then https://arctri-website.vercel.app
SITE_URL=

# --- /admin dashboard ---
# Shared password for /admin
ADMIN_PASSWORD=
# Long random string that signs the session cookie: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Vercel access token (Account Settings > Tokens), scoped to the team that owns this project
VERCEL_ACCESS_TOKEN=
# Project Settings > General > Project ID (or .vercel/project.json after `vercel link`)
VERCEL_PROJECT_ID=
# Optional: only if the project belongs to a team (orgId in .vercel/project.json)
VERCEL_TEAM_ID=
# Optional: raises the GitHub API rate limit for the downloads table
GITHUB_TOKEN=

# Optional: manifest the website reads for the sync-status card (defaults to the production latest.json)
MANIFEST_URL=

# --- Release publishing (scripts/publish-release.mjs, GitHub Action) ---
# Vercel Blob read/write token for the arctri-downloads store
BLOB_READ_WRITE_TOKEN=
